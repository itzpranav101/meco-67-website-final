PORT=3000
PUBLIC_APP_URL=http://localhost:3000
CLERK_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Clerk
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional; Meco derives this from the publishable key when omitted.
CLERK_ISSUER=

# Appwrite (server-only)
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
APPWRITE_TABLE_ID=meco_records
APPWRITE_TABLE_NAME=Meco records
APPWRITE_API_KEY=

# Multi-speaker transcription (batch, after the recording)
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro

# Live conversation transcription (streamed while the visit happens).
# The key stays on the server; the browser streams audio through /api/live-transcribe.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# Local voice-recognition backend (voice-id/server.py) used to name speakers
# from enrolled voiceprints. Leave blank to disable voiceprint matching.
VOICE_ID_SERVER=http://127.0.0.1:8765
# Required only if voice-id/server.py is deployed with a public URL (rather than
# run on localhost), set the same value on both services so Node's requests are
# accepted and randoms on the internet can't call it directly. Leave blank locally.
VOICE_ID_SECRET=

# Optional live transcript translation (server-only token).
APIFY_API_TOKEN=

# AI visit summaries. Gemini first, Groq fallback.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Set to true only for offline local UI testing. Production should remain false.
ALLOW_LOCAL_DEMO=false
